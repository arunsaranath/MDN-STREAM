"wavelength" DFNT_INT32 2 1 DSIZE_DIM_NM nbands MN_MX_CK 412 865
"vcal_gain" DFNT_FLOAT32 2 1 DSIZE_DIM_NM nbands NO_MN_MX
"vcal_offset" DFNT_FLOAT32 2 1 DSIZE_DIM_NM nbands NO_MN_MX
"F0" DFNT_FLOAT32 2 1 DSIZE_DIM_NM nbands NO_MN_MX
