# seawifs_l2_gac.fmt - format table for SeaWiFS L2 GAC data
#
# Using the new fmt_check table format of March, 2005
#  (see ww:~/txt/QCinfo/fmt_check_tbl_25mar05.txt or
#  http://oceancolor.gsfc.nasa.gov/staff/wayne/fmt_check_tbl.html )
#
#  W. Robinson, SAIC, 19 May 05 change K_490 long name
#  W. Robinson, SAIC, 28 Aug 09 update for the 2009 reprocessing
#
#  Attribute Section
#  form: **ATTR <# description lines>
#
**ATTR 263
#
#  description lines have the form:
# <obj nm> <att nm> <in nm> <type> <# values> <rd code> [ <value(s)> ]
#   with:
#  <type> can be DFNT_CHAR, DFNT_FLOAT32, DFNT_FLOAT64, DFNT_INT16, DFNT_INT32,
#         DFNT_INT8, DFNT_UINT8
#  <rd code> can be NOREAD, READ_NOCK, READ_ONE_VAL, READ_INCLUSIVE
"gbl" "Product Name" "Product Name" DFNT_CHAR -1 READ_NOCK
"gbl" "Title" "Title" DFNT_CHAR -1 READ_ONE_VAL "SeaWiFS Level-2 Data"
"gbl" "Sensor Name" "Sensor Name" DFNT_CHAR -1 READ_ONE_VAL "SeaWiFS"
"gbl" "Software Name" "Software Name" DFNT_CHAR -1 READ_ONE_VAL "l2gen"
"gbl" "Software Version" "Software Version" DFNT_CHAR -1 READ_NOCK
"gbl" "Processing Version" "Processing Version" DFNT_CHAR -1 READ_NOCK
"gbl" "Processing Time" "Processing Time" DFNT_CHAR -1 READ_NOCK
"gbl" "Processing Control" "Processing Control" DFNT_CHAR -1 READ_NOCK
"gbl" "Input Parameters" "Input Parameters" DFNT_CHAR -1 READ_NOCK
"gbl" "Input Files" "Input Files" DFNT_CHAR -1 READ_NOCK
"gbl" "Calibration Data" "Calibration Data" DFNT_CHAR -1 READ_NOCK
#
#  SeaWiFS specific section
"gbl" "Data Center" "Data Center" DFNT_CHAR -1 READ_ONE_VAL "NASA/GSFC SeaWiFS Data Processing Center"
#"gbl" "Station Name" "Station Name" DFNT_CHAR -1 READ_ONE_VAL "Wallops Flight Facility"
#"gbl" "Station Latitude" "Station Latitude" DFNT_FLOAT32 1 READ_ONE_VAL 37.9272
#"gbl" "Station Longitude" "Station Longitude" DFNT_FLOAT32 1 READ_ONE_VAL -75.4753
"gbl" "Station Name" "Station Name" DFNT_CHAR -1 READ_NOCK
"gbl" "Station Latitude" "Station Latitude" DFNT_FLOAT32 1 READ_NOCK
"gbl" "Station Longitude" "Station Longitude" DFNT_FLOAT32 1 READ_NOCK
#  this is Fred's proposed.  leave as-is for now
#"gbl" "Mission" "Mission" DFNT_CHAR -1 READ_ONE_VAL "OrbView-2 SeaWiFS"
"gbl" "Mission" "Mission" DFNT_CHAR -1 READ_ONE_VAL "SeaStar SeaWiFS"
"gbl" "Mission Characteristics" "Mission Characteristics" DFNT_CHAR -1 READ_ONE_VAL "Nominal orbit: inclination = 98.2 (Sun-synchronous); node = 12 noon local (descending); eccentricity = <0.002; altitude = 705 km; ground speed = 6.75 km/sec"
"gbl" "Sensor" "Sensor" DFNT_CHAR -1 READ_ONE_VAL "Sea-viewing Wide Field-of-view Sensor (SeaWiFS)"
"gbl" "Sensor Characteristics" "Sensor Characteristics" DFNT_CHAR -1 READ_ONE_VAL "Number of bands = 8; number of active bands = 8; wavelengths per band (nm) = 412, 443, 490, 510, 555, 670, 765, 865; bits per pixel = 10; instantaneous field-of-view = 1.5835 mrad; pixels per scan = 1285; scan rate = 6/sec; sample rate = 7710/sec"
"gbl" "Data Type" "Data Type" DFNT_CHAR -1 READ_ONE_VAL "GAC"
#
"gbl" "Start Time" "Start Time" DFNT_CHAR -1 READ_NOCK
"gbl" "End Time" "End Time" DFNT_CHAR -1 READ_NOCK
"gbl" "Day or Night" "Day or Night" DFNT_CHAR -1 READ_NOCK
"gbl" "Scene Center Time" "Scene Center Time" DFNT_CHAR -1 READ_NOCK
"gbl" "Node Crossing Time" "Node Crossing Time" DFNT_CHAR -1 READ_NOCK
"gbl" "Start Year" "Start Year" DFNT_INT16 1 READ_INCLUSIVE 1994 2050
"gbl" "Start Day" "Start Day" DFNT_INT16 1 READ_INCLUSIVE 1 366
"gbl" "Start Millisec" "Start Millisec" DFNT_INT32 1 READ_INCLUSIVE 0 86399999
"gbl" "End Year" "End Year" DFNT_INT16 1 READ_INCLUSIVE 1994 2050
"gbl" "End Day" "End Day" DFNT_INT16 1 READ_INCLUSIVE 1 366
"gbl" "End Millisec" "End Millisec" DFNT_INT32 1 READ_INCLUSIVE 0 86399999
"gbl" "Start Node" "Start Node" DFNT_CHAR -1 READ_NOCK
"gbl" "End Node" "End Node" DFNT_CHAR -1 READ_NOCK
"gbl" "Orbit Number" "Orbit Number" DFNT_INT32 1 READ_NOCK
#
"gbl" "Pixels per Scan Line" "Pixels per Scan Line" DFNT_INT32 1 READ_ONE_VAL 248
"gbl" "Number of Scan Lines" "Number of Scan Lines" DFNT_INT32 1 READ_INCLUSIVE 1 30000
"gbl" "Number of Bands" "Number of Bands" DFNT_INT32 1 READ_ONE_VAL 8
"gbl" "LAC Pixel Start Number" "LAC Pixel Start Number" DFNT_INT32 1 READ_ONE_VAL 147
"gbl" "LAC Pixel Subsampling" "LAC Pixel Subsampling" DFNT_INT32 1 READ_ONE_VAL 4
"gbl" "Scene Center Scan Line" "Scene Center Scan Line" DFNT_INT32 1 READ_INCLUSIVE 0 10000
"gbl" "Number of Scan Control Points" "Number of Scan Control Points" DFNT_INT32 1 READ_NOCK
"gbl" "Number of Pixel Control Points" "Number of Pixel Control Points" DFNT_INT32 1 READ_NOCK
"gbl" "Mask Names" "Mask Names" DFNT_CHAR -1 READ_NOCK
"gbl" "Flag Percentages" "Flag Percentages" DFNT_FLOAT32 32 READ_INCLUSIVE 0.0 100.0
#
"gbl" "Latitude Units" "Latitude Units" DFNT_CHAR -1 READ_ONE_VAL "degrees North"
"gbl" "Longitude Units" "Longitude Units" DFNT_CHAR -1 READ_ONE_VAL "degrees East"
"gbl" "Scene Center Latitude" "Scene Center Latitude" DFNT_FLOAT32 1 READ_INCLUSIVE  -90.0 90.0
"gbl" "Scene Center Longitude" "Scene Center Longitude" DFNT_FLOAT32 1 READ_INCLUSIVE -180.0 180.0
"gbl"  "Scene Center Solar Zenith"  "Scene Center Solar Zenith"  DFNT_FLOAT32  1  READ_INCLUSIVE  -360.0 360.0
"gbl" "Upper Left Latitude" "Upper Left Latitude" DFNT_FLOAT32 1 READ_INCLUSIVE -90.0 90.0
"gbl" "Upper Left Longitude" "Upper Left Longitude" DFNT_FLOAT32 1 READ_INCLUSIVE -180.0 180.0
"gbl" "Upper Right Latitude" "Upper Right Latitude" DFNT_FLOAT32 1 READ_INCLUSIVE -90.0 90.0
"gbl" "Upper Right Longitude" "Upper Right Longitude" DFNT_FLOAT32 1 READ_INCLUSIVE -180.0 180.0
"gbl" "Lower Left Latitude" "Lower Left Latitude" DFNT_FLOAT32 1 READ_INCLUSIVE -90.0 90.0
"gbl" "Lower Left Longitude" "Lower Left Longitude" DFNT_FLOAT32 1 READ_INCLUSIVE -180.0 180.0
"gbl" "Lower Right Latitude" "Lower Right Latitude" DFNT_FLOAT32 1 READ_INCLUSIVE -90.0 90.0
"gbl" "Lower Right Longitude" "Lower Right Longitude" DFNT_FLOAT32 1 READ_INCLUSIVE -180.0 180.0
"gbl" "Northernmost Latitude" "Northernmost Latitude" DFNT_FLOAT32 1 READ_INCLUSIVE -90.0 90.0
"gbl" "Southernmost Latitude" "Southernmost Latitude" DFNT_FLOAT32 1 READ_INCLUSIVE -90.0 90.0
"gbl" "Westernmost Longitude" "Westernmost Longitude" DFNT_FLOAT32 1 READ_INCLUSIVE -180.0 180.0
"gbl" "Easternmost Longitude" "Easternmost Longitude" DFNT_FLOAT32 1 READ_INCLUSIVE -180.0 180.0
"gbl" "Start Center Latitude" "Start Center Latitude" DFNT_FLOAT32 1 READ_INCLUSIVE -90.0 90.0
"gbl" "Start Center Longitude" "Start Center Longitude" DFNT_FLOAT32 1 READ_INCLUSIVE -180.0 180.0
"gbl" "End Center Latitude" "End Center Latitude" DFNT_FLOAT32 1 READ_INCLUSIVE -90.0 90.0
"gbl" "End Center Longitude" "End Center Longitude" DFNT_FLOAT32 1 READ_INCLUSIVE -180.0 180.0
"gbl" "Orbit Node Longitude" "Orbit Node Longitude" DFNT_FLOAT32 1 READ_INCLUSIVE -180.0 180.0
"gbl" "Earth-Sun Distance Correction" "Earth-Sun Distance Correction" DFNT_FLOAT64 1 READ_NOCK
#
# attributes for SDSes
#
"year" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Scan year"
"year" "valid_range" "valid_range" DFNT_INT32 2 READ_ONE_VAL    1996 2038
"year" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "years"
"day" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Scan day of year"
"day" "valid_range" "valid_range" DFNT_INT32 2 READ_ONE_VAL  1 366
"day" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "days"
"msec" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Scan-line time, milliseconds of day"
"msec" "valid_range" "valid_range" DFNT_INT32 2 READ_ONE_VAL 0 86399999
"msec" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "milliseconds"
"slat" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Scan start-pixel latitude"
"slat" "valid_range" "valid_range" DFNT_FLOAT32 2 READ_ONE_VAL -90. 90.
"slat" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "degrees"
"slon" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Scan start-pixel longitude"
"slon" "valid_range" "valid_range" DFNT_FLOAT32 2 READ_ONE_VAL -180. 180.
"slon" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "degrees"
"clat" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Scan center-pixel latitude"
"clat" "valid_range" "valid_range" DFNT_FLOAT32 2 READ_ONE_VAL -90. 90.
"clat" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "degrees"
"clon" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Scan center-pixel longitude"
"clon" "valid_range" "valid_range" DFNT_FLOAT32 2 READ_ONE_VAL -180. 180.
"clon" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "degrees"
"elat" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Scan end-pixel latitude"
"elat" "valid_range" "valid_range" DFNT_FLOAT32 2 READ_ONE_VAL -90. 90.
"elat" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "degrees"
"elon" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Scan end-pixel longitude"
"elon" "valid_range" "valid_range" DFNT_FLOAT32 2 READ_ONE_VAL -180. 180.
"elon" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "degrees"
"csol_z"  "long_name"  "long_name"  DFNT_CHAR  -1  READ_ONE_VAL "Scan center-pixel solar zenith angle"
"csol_z"  "valid_range"  "valid_range"  DFNT_FLOAT32  2  READ_ONE_VAL  0. 180.
"csol_z" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "degrees"
