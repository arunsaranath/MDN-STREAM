"cntl_pt_cols" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Pixel control points"
"cntl_pt_cols" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "none"
"cntl_pt_rows" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Scan control points"
"cntl_pt_rows" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "none"
"longitude" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Longitudes at control points"
"longitude" "valid_range"  "valid_range"  DFNT_FLOAT32  2  READ_ONE_VAL  -180. 180.
"longitude" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "degrees"
"latitude" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Latitudes at control points"
"latitude" "valid_range"  "valid_range"  DFNT_FLOAT32  2  READ_ONE_VAL  -90.  90.
"latitude" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "degrees"
"tilt" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Tilt angle for scan line"
"tilt" "valid_range" "valid_range" DFNT_FLOAT32 2 READ_ONE_VAL -20.1 20.1
"tilt" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "degrees"
#
"orb_vec"  "long_name"  "long_name"  DFNT_CHAR  -1  READ_ONE_VAL "Orbit position vector at scan line time"
"orb_vec"  "valid_range"  "valid_range"  DFNT_FLOAT32  2  READ_ONE_VAL  -7200. 7200.
"orb_vec"  "units"  "units"  DFNT_CHAR  -1  READ_ONE_VAL  "kilometers"
"sun_ref"  "long_name"  "long_name"  DFNT_CHAR  -1  READ_ONE_VAL "Reference Sun vector in ECEF frame"
"sun_ref"  "valid_range"  "valid_range"  DFNT_FLOAT32  2  READ_ONE_VAL  -1. 1.
"att_ang"  "long_name"  "long_name"  DFNT_CHAR  -1  READ_ONE_VAL "Computed yaw, roll, pitch"
"att_ang"  "valid_range"  "valid_range"  DFNT_FLOAT32  2  READ_ONE_VAL  -180. 180.
"sen_mat"  "long_name"  "long_name"  DFNT_CHAR  -1  READ_ONE_VAL "ECEF-to-sensor-frame matrix"
"sen_mat"  "valid_range"  "valid_range"  DFNT_FLOAT32  2  READ_ONE_VAL  -1. 1.
"scan_ell"  "long_name"  "long_name"  DFNT_CHAR  -1  READ_ONE_VAL "Scan-track ellipse coefficients"
"nflag"  "long_name"  "long_name"  DFNT_CHAR  -1  READ_ONE_VAL "Navigation flags"
#
"ntilts"  "long_name"  "long_name"  DFNT_CHAR  -1  READ_ONE_VAL "Number of scene tilt states"
"tilt_flags"  "long_name"  "long_name"  DFNT_CHAR  -1  READ_ONE_VAL "Tilt indicators"
"tilt_flags"  "valid_range"  "valid_range"  DFNT_INT16  2  READ_ONE_VAL  -1 3
"tilt_ranges"  "long_name"  "long_name"  DFNT_CHAR  -1  READ_ONE_VAL "Scan-line number ranges of scene tilt states"
#
"wavelength" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Wavelengths"
"wavelength" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "nm"
"vcal_gain" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Vicarious Calibration Gain"
"vcal_gain" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "dimensionless"
"vcal_offset" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Vicarious Calibration Offset
"vcal_offset" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "mW cm^-2 um^-1 sr^-1"
"F0" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Mean Solar Flux"
"F0" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "mW cm^-2 um^-1"
"k_oz" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Ozone Absorption Coefficient"
"k_oz" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "cm^-1"
"Tau_r" "long_name" "long_name" DFNT_CHAR -1 READ_ONE_VAL "Rayleigh Optical Thickness"
"Tau_r" "units" "units" DFNT_CHAR -1 READ_ONE_VAL "dimensionless"
#
#
#  Array Dimension Section
#  form: **ARR_DIM <# array dim definitions>
#
**ARR_DIM 5
#
#  definition lines for dimensions to save, etc
#  <name in gbl attribs> <short name>
"Pixels per Scan Line"  npix
"Number of Scan Lines"  nlin
"Number of Scan Control Points" nctl_lin
"Number of Pixel Control Points" nctl_pix
"Number of Bands" nbands
#
#  Science Dataset Section
#  form: **SDS <# SDS descriptions>
#
**SDS 45
#
#  descriptions have the form:
# <name>  <type>  <# attr> <rank>   <dim 1 key> <size>  [<dim 2 key> <size> [<dim 3 key> <size> ] ]  <chk mn mx?>  [ <mn> <mx> ]
#  <type> is same data type as in attrib description
#  <dim X key>  can be: DSIZE_NOCK, DSIZE_CK, DSIZE_DIM_NM
#  <chk mn mx?>  can be: NO_MN_MX, MN_MX_CK
#  
# <name>  <type>  <# attr> <rank>   <dim 1 key> <size>  [<dim 2 key> <size> [<dim 3 key> <size> ] ]  <chk mn mx?>  [ <mn> <mx> ]
"year" DFNT_INT32 3 1 DSIZE_DIM_NM nlin MN_MX_CK 1996 2038
"day" DFNT_INT32 3 1 DSIZE_DIM_NM nlin MN_MX_CK 1 366
"msec" DFNT_INT32 3 1 DSIZE_DIM_NM nlin MN_MX_CK 0  86399999
"slat" DFNT_FLOAT32 3 1 DSIZE_DIM_NM nlin MN_MX_CK -90.0 90.0
"slon" DFNT_FLOAT32 3 1 DSIZE_DIM_NM nlin MN_MX_CK -180.0  180.0
"clat" DFNT_FLOAT32 3 1 DSIZE_DIM_NM nlin MN_MX_CK -90.0 90.0
"clon" DFNT_FLOAT32 3 1 DSIZE_DIM_NM nlin MN_MX_CK -180.0  180.0
"elat" DFNT_FLOAT32 3 1 DSIZE_DIM_NM nlin MN_MX_CK -90.0 90.0
"elon" DFNT_FLOAT32 3 1 DSIZE_DIM_NM nlin MN_MX_CK -180.0  180.0
"csol_z" DFNT_FLOAT32 3 1 DSIZE_DIM_NM nlin MN_MX_CK 0.0  180.0
#
"Rrs_412"  DFNT_INT16 7 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"Rrs_443"  DFNT_INT16 7 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"Rrs_490"  DFNT_INT16 7 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"Rrs_510"  DFNT_INT16 7 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"Rrs_555"  DFNT_INT16 7 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"Rrs_670"  DFNT_INT16 7 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"chlor_a"  DFNT_FLOAT32 6 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"Kd_490"  DFNT_INT16 6 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"pic"  DFNT_INT16 6 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"poc"  DFNT_INT16 6 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"cdom_index"  DFNT_INT16 6 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"par"  DFNT_INT16 6 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"aot_865"  DFNT_INT16 6 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"angstrom"  DFNT_INT16 6 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
"l2_flags"  DFNT_INT32 36 2 DSIZE_DIM_NM nlin DSIZE_DIM_NM npix NO_MN_MX
#
"cntl_pt_cols" DFNT_INT32 2 1 DSIZE_DIM_NM nctl_pix MN_MX_CK 0 1286
"cntl_pt_rows" DFNT_INT32 2 1 DSIZE_DIM_NM nctl_lin MN_MX_CK 0 10000
"longitude" DFNT_FLOAT32 3 2 DSIZE_DIM_NM nctl_lin DSIZE_DIM_NM nctl_pix MN_MX_CK -180. 180.
"latitude" DFNT_FLOAT32 3 2 DSIZE_DIM_NM nctl_lin DSIZE_DIM_NM nctl_pix MN_MX_CK -90. 90.
"tilt" DFNT_FLOAT32 3 1 DSIZE_DIM_NM nlin MN_MX_CK  -20.5 20.5
#
"orb_vec" DFNT_FLOAT32 3 2 DSIZE_DIM_NM nlin DSIZE_CK 3 MN_MX_CK -7200.0 7200.0
#"l_vert"      DFNT_FLOAT32   2     2    DSIZE_DIM_NM  nlin    DSIZE_CK     3    MN_MX_CK    -1.0 1.0
"sun_ref"     DFNT_FLOAT32   2     2    DSIZE_DIM_NM  nlin    DSIZE_CK     3    MN_MX_CK    -1.0 1.0
"att_ang"     DFNT_FLOAT32   2     2    DSIZE_DIM_NM  nlin    DSIZE_CK     3    MN_MX_CK    -180.0 180.0
"sen_mat"     DFNT_FLOAT32   2     3    DSIZE_DIM_NM  nlin    DSIZE_CK     3    DSIZE_CK  3     MN_MX_CK    -1.0 1.0
"scan_ell"    DFNT_FLOAT32   1     2    DSIZE_DIM_NM  nlin    DSIZE_CK     6    NO_MN_MX
"nflag"       DFNT_INT32     1     2    DSIZE_DIM_NM  nlin    DSIZE_CK     8    NO_MN_MX
